<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_mobile_requires_receipt_form" model="ir.ui.view">
        <field name="name">product.template.mobile.requires.receipt.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hr_expense.view_product_hr_expense_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 20 appends "Expenses" at the end of the options row, so ours follows it. -->
            <div name="options" position="inside">
                <span class="d-inline-flex" invisible="not can_be_expensed">
                    <field name="mobile_requires_receipt" widget="boolean_checkbox" class="w-auto"/>
                    <label for="mobile_requires_receipt"/>
                </span>
            </div>
        </field>
    </record>

</odoo>
