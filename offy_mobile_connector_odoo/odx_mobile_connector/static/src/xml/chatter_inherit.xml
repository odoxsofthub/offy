<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- Hide "Send message" on mobile chatters: only internal Log notes are used. -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">!['mobile.feature', 'mobile.config'].includes(props.threadModel)</attribute>
        </xpath>
    </t>

</templates>
